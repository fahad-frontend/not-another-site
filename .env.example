# Contact form (Resend)
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Destination inbox for contact form submissions
CONTACT_TO_EMAIL=hello@notanother.site

# Verified sender. Defaults to onboarding@resend.dev when unset
# (only works for the account owner email in development).
CONTACT_FROM_EMAIL=
